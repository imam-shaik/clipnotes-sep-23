{
  "manifest_version": 3,
  "name": "Clip Notes",
  "version": "1.0.0",
  "description": "Take screenshots, vector notes, and create TOC for YouTube videos with local saving",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "downloads",
    "contextMenus",
    "windows",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://youtube.com/*",
    "*://www.youtube.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "css": [
        "content/content-styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Open Clip Notes",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "lib/*"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}